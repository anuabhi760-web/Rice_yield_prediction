# OPTIONAL — only needed for "AI-written replies" (Hindi/Telugu/Bengali/Tamil + more natural wording).
# The chatbot works without any key, answering from the data in English.
#
# Streamlit Community Cloud:  App -> Settings -> Secrets  -> paste the lines below (with your real key).
# Local run:                  save this file as  .streamlit/secrets.toml  (and NEVER commit that file to GitHub).

ANTHROPIC_API_KEY = "paste-your-key-here"
# ANTHROPIC_MODEL = "claude-haiku-5-5"      # optional override

# Or use Google Gemini instead:
# GEMINI_API_KEY = "paste-your-key-here"
# GEMINI_MODEL   = "a-current-model-name-from-Google-AI-Studio"
